# Client build config (Vite). Copy to `.env.local` for local dev, or set these as
# GitHub repo *variables* so the Pages build embeds them (see deploy.yml).
#
# The two VITE_ values are PUBLIC (safe to expose in the built site). Leave them
# BLANK/unset to build without the shared Online Farm gameplay server.

# Base URL of the game server (your deployed Cloudflare Worker).
# Local dev points at `wrangler dev`:
VITE_API_URL=http://127.0.0.1:8787

# Google OAuth 2.0 Web client id (Sign in with Google). Leave blank to disable the
# Google button; local e2e uses the dev sign-in bypass instead (window.zfDevSignIn).
VITE_GOOGLE_CLIENT_ID=

# Optional Personal Cloud Farm (Vercel server-side only; never prefix these with
# VITE_). Linking a private Vercel Blob store supplies BLOB_READ_WRITE_TOKEN.
# PERSONAL_CLOUD_KEY_HASH is the SHA-256 hex digest of the private pairing token.
BLOB_READ_WRITE_TOKEN=
PERSONAL_CLOUD_KEY_HASH=
